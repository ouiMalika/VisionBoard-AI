# Stage 1 — build the Angular app (selfhosted config: demoMode off, apiUrl /api)
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx ng build --configuration selfhosted

# Stage 2 — serve static files with nginx + reverse-proxy to backend
FROM nginx:alpine
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
