# ============================================================
#  VisionBoard AI — Production Environment Variables
#  Distributed free-tier deployment:
#    Frontend  → Vercel
#    API       → Render (this service)
#    Worker    → Hugging Face Spaces (set vars there separately)
#    Database  → Neon
#    Redis     → Upstash
#    Storage   → Cloudflare R2
#  Never commit actual secrets to git.
# ============================================================

# ─── Django ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Your Render web service hostname (no https://, no trailing slash)
# Example: visionboard-api.onrender.com
ALLOWED_HOSTS=visionboard-api.onrender.com

# ─── Database (Neon PostgreSQL) ────────────────────────────
# Full connection string from the Neon dashboard.
# This replaces the individual POSTGRES_* variables.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/visionboard?sslmode=require

# ─── Redis (Upstash — TLS required) ───────────────────────
# Use rediss:// (double-s) for TLS. Broker and result backend
# should point to the same Upstash database.
CELERY_BROKER_URL=rediss://default:password@hostname.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:password@hostname.upstash.io:6379

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ─── Storage (Cloudflare R2) ───────────────────────────────
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# Then create an API token with R2 read+write permissions
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=visionboard-ai
# R2 doesn't use regions, but boto3 requires a value
AWS_S3_REGION_NAME=auto
# Your R2 account endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ─── Worker (set in HF Spaces Secrets panel, not here) ────
# CELERY_BROKER_URL=rediss://...   (same as above)
# CELERY_RESULT_BACKEND=rediss://... (same as above)
# BACKEND_URL=https://visionboard-api.onrender.com
