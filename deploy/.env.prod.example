# ============================================================
#  VisionBoard AI — Production Environment Variables
#  Copy this to deploy/.env.prod and fill in all values.
#  Never commit .env.prod to git.
# ============================================================

# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Your VM's public IP, or your domain if you have one
# Example: ALLOWED_HOSTS=152.70.12.34  or  ALLOWED_HOSTS=visionboard.yourdomain.com
ALLOWED_HOSTS=YOUR_VM_PUBLIC_IP

# PostgreSQL
POSTGRES_DB=visionboard
POSTGRES_USER=visionboard
POSTGRES_PASSWORD=change-me-strong-password

# Storage — Cloudflare R2 (free, S3-compatible)
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# Then create an API token with R2 read+write permissions
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=visionboard-ai
# R2 doesn't use regions, but boto3 requires a value
AWS_S3_REGION_NAME=auto
# Your R2 account endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
