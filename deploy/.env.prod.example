# ============================================================
#  VisionBoard AI — Production Environment Variables
#  Free-tier deployment:
#    Frontend  → Vercel
#    API       → Hugging Face Spaces (HF Space #1)
#    Worker    → Hugging Face Spaces (HF Space #2)
#    Database  → Neon
#    Redis     → Upstash
#    Storage   → AWS S3
#  Set these as Secrets in each HF Space. Never commit secrets to git.
# ============================================================

# ─── Django (API Space) ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Your HF Space hostname for the API space (no https://, no trailing slash)
# Example: username-visionboard-api.hf.space
ALLOWED_HOSTS=YOUR-USERNAME-visionboard-api.hf.space

# ─── Database (Neon PostgreSQL) ────────────────────────────
# Full connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/visionboard?sslmode=require

# ─── Redis (Upstash — TLS required) ───────────────────────
# Use rediss:// (double-s) for TLS.
CELERY_BROKER_URL=rediss://default:password@hostname.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:password@hostname.upstash.io:6379

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ─── Storage (AWS S3) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=visionboard-ai
AWS_S3_REGION_NAME=us-east-1
# No AWS_S3_ENDPOINT_URL needed for standard AWS S3

# ─── Worker Space secrets (set in HF Space #2, not here) ──
# CELERY_BROKER_URL=rediss://...        (same Upstash URL)
# CELERY_RESULT_BACKEND=rediss://...   (same Upstash URL)
# BACKEND_URL=https://YOUR-USERNAME-visionboard-api.hf.space
